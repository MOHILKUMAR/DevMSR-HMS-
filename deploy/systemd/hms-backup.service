# Copy to /etc/systemd/system/, then: sudo systemctl daemon-reload && sudo systemctl enable --now hms-backup.timer
[Unit]
Description=DevMSR HMS encrypted database backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=hmsadmin
Environment=HMS_HOME=/opt/hms
ExecStart=/opt/hms/src/deploy/backup.sh
