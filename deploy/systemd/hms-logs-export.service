# Copy to /etc/systemd/system/, then: sudo systemctl daemon-reload && sudo systemctl enable --now hms-logs-export.timer
# hmsadmin must be in the systemd-journal group to read every log.
[Unit]
Description=DevMSR HMS daily encrypted log export
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=hmsadmin
Environment=HMS_HOME=/opt/hms
ExecStart=/opt/hms/src/deploy/logs-export.sh
