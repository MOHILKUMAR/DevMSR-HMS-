# Copy to $HMS_HOME/env/api.env on the server (mode 600). Placeholders only: the developer fills in
# real values on the server and keeps a copy in the second safe place (docs/runbooks/secrets-and-rotation.md).

NODE_ENV=production
# staging or production. Production refuses mock adapters, a missing SENTRY_DSN, demo or look-alike
# secrets and an API database login with too many rights (docs/decisions.md, start-up guard).
APP_ENV=staging
PORT=4000
CORS_ORIGINS=https://app.example.in
LOG_LEVEL=info

# Supabase session pooler (port 5432 on the pooler host) or a direct connection. Not the transaction
# pooler on 6543 until deploy/check-database.sh passes against it (docs/runbooks/supabase.md).
# The API's own restricted login (member of hms_api), never the owner in migrate.env. deploy.sh creates
# it, or resets its password, from this value on every deploy. Password: 16 or more characters. Through
# Supabase's pooler the user name is hms_app.<project-ref>.
DATABASE_URL=postgresql://hms_app:PASSWORD@HOST:5432/postgres?sslmode=require
# Background jobs (pg-boss, such as the midnight room and nursing charges) run inside the API, with
# a login that owns only the pgboss schema. deploy.sh creates it with the API login. Production
# refuses to start with jobs on and no login of their own. Through the pooler: hms_jobs.<project-ref>.
JOBS_ENABLED=true
JOBS_DATABASE_URL=postgresql://hms_jobs:PASSWORD@HOST:5432/postgres?sslmode=require
# Only if the API rejects the database certificate: put Supabase's CA in $HMS_HOME/db-certs/ and set
# NODE_EXTRA_CA_CERTS=/etc/hms/db-certs/supabase-ca.crt

# Generate each once with: openssl rand -base64 32
# Losing FIELD_ENCRYPTION_KEY loses every Aadhaar and ABHA number.
SESSION_SECRET=
FIELD_ENCRYPTION_KEY=

# Parent domain of the app. and api. hosts, with the leading dot.
COOKIE_DOMAIN=.example.in
# Cloudflare, then Caddy: the API trusts two proxy hops for the client IP.
TRUST_PROXY=2

RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_EXPORT_PER_HOUR=10

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_FILES=hms-files
# Required when APP_ENV=production.
SENTRY_DSN=

# Staging keeps the mock adapters. Production needs real ones: with APP_ENV=production the API refuses mocks.
PAYMENTS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
ABDM_MODE=off

# true only after a test email has been checked on staging.
MAIL_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=
MAIL_REPLY_TO=
