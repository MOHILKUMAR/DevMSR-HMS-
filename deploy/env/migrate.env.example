# Copy to $HMS_HOME/env/migrate.env on the server (mode 600). Used only by the one-off migrate container.
# A session or direct connection: Prisma migrations need advisory locks that a transaction pooler breaks.
# When the API gets its own restricted database role (go-live checklist stage 4), this stays the
# owner role that may change the schema.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
