# Copy to $HMS_HOME/env/migrate.env on the server (mode 600). The owner of the tables (on Supabase,
# postgres): migrations run as it, and deploy.sh uses it to create or update the API's restricted login
# from DATABASE_URL in api.env. Never given to the running API.
# A session or direct connection: Prisma migrations need advisory locks that a transaction pooler breaks.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
