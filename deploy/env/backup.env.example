# Copy to $HMS_HOME/env/backup.env on the server (mode 600). Used by deploy/backup.sh,
# deploy/restore-drill.sh and deploy/logs-export.sh. Never shared with the app containers.

# staging or production: part of every backup file name.
BACKUP_LABEL=production
# Session pooler or direct connection, read-only use. When the database gets a read-only backup role,
# use it here.
BACKUP_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# age public keys (age1...), space separated: the developer's key and the hospital's key. The private
# keys never touch the server (docs/runbooks/backup-and-restore.md).
AGE_RECIPIENTS=

# Where backups and log exports go: an rclone remote named "store", configured below, and a path.
# A path starting with / is a local folder: tests and rehearsals only.
BACKUP_STORE=store:hms-backups/production
LOG_STORE=store:hms-logs/production

# The store: a bucket in a separate account from production, with a token that can write and read
# but whose bucket lock stops deletes (docs/runbooks/backup-and-restore.md). Example for Cloudflare R2:
RCLONE_CONFIG_STORE_TYPE=s3
RCLONE_CONFIG_STORE_PROVIDER=Cloudflare
RCLONE_CONFIG_STORE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_STORE_ACCESS_KEY_ID=
RCLONE_CONFIG_STORE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_STORE_NO_CHECK_BUCKET=true

# Optional heartbeat URLs from the uptime service (docs/runbooks/monitoring.md).
BACKUP_PING_URL=
BACKUP_PING_FAIL_URL=
# Heartbeats for deploy/check-host.sh (hourly).
HOST_PING_URL=
HOST_PING_FAIL_URL=
