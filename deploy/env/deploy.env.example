# Copy to $HMS_HOME/env/deploy.env on the server (mode 600). Read by deploy.sh, rollback.sh and
# docker compose. Holds hosts and build arguments only: no secrets.

# Public host names. Cloudflare proxies both (docs/runbooks/cloudflare.md).
APP_HOST=app.example.in
API_HOST=api.example.in

# Inlined into the browser bundle at build time. Everything here is sent to every browser.
NEXT_PUBLIC_API_URL=https://api.example.in/api/v1
# staging or production
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SENTRY_DSN=

# Release tags must be on this branch.
HMS_RELEASE_BRANCH=main
