# Staging and production reverse proxy (CLAUDE.md section 3): app. to Next.js on 3000, api. to
# NestJS on 4000. Cloudflare sits in front with TLS set to full (strict) and authenticated origin
# pulls, so only Cloudflare can complete a TLS handshake here (docs/runbooks/cloudflare.md).
{
	# Certificates are Cloudflare origin CA files, so Caddy never asks Let's Encrypt for one.
	# The HTTP to HTTPS redirect on port 80 stays on.
	auto_https disable_certs
	# Nothing may reconfigure the running server.
	admin off

	servers {
		# Only Cloudflare may say who the client is. CF-Connecting-IP becomes the client IP in
		# the access log, and X-Forwarded-For from Cloudflare is kept for the API.
		import /etc/caddy/snippets/cloudflare-ips.caddy
		client_ip_headers CF-Connecting-IP
		timeouts {
			read_header 10s
			read_body 60s
			idle 2m
		}
	}

	# JSON to stdout, where Docker's journald driver keeps it. Caddy redacts Cookie and
	# Authorization headers by default; bodies are never logged.
	log {
		output stdout
		format json
	}
}

(origin) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/certs/origin-pull-ca.pem
		}
	}
	encode zstd gzip
	header {
		-Server
		-Via
	}
	log
}

{$APP_HOST} {
	import origin
	reverse_proxy web:3000
}

{$API_HOST} {
	import origin
	# Uploads are capped at 10 MB (CLAUDE.md section 9). The margin is for multipart overhead.
	request_body {
		max_size 11MB
	}
	reverse_proxy api:4000
}
