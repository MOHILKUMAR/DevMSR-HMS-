meta {
  name: Prepare the final bill
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/discharges/{{dischargeId}}/final-bill
  body: none
  auth: none
}

headers {
  X-CSRF-Token: {{csrfToken}}
  Idempotency-Key: {{idempotencyKey}}
}

docs {
  Posts any room and nursing days not charged yet, then drafts a bill of every unbilled charge. Issue it with "Issue the bill" in the billing folder, using invoiceId.
}

script:pre-request {
  // A new key each run. Send the request again without this script to see the stored response.
  bru.setVar("idempotencyKey", require("crypto").randomUUID());
}

script:post-response {
  bru.setVar("invoiceId", res.body.id);
}

assert {
  res.status: eq 201
}
