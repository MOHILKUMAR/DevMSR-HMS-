meta {
  name: Change own password (expect 422 with a wrong current password)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/password
  body: json
  auth: none
}

headers {
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "currentPassword": "not-the-current-password",
    "newPassword": "a-new-password-of-mine"
  }
}

assert {
  res.status: eq 422
}
