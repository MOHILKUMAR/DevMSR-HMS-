meta {
  name: Login as nurse
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "username": "nurse",
    "password": "{{seedPassword}}"
  }
}

script:post-response {
  bru.setVar("csrfToken", res.body.csrfToken);
}

assert {
  res.status: eq 200
}
