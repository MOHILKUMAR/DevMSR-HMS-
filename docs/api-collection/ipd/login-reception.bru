meta {
  name: Login as receptionist
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "username": "reception",
    "password": "{{seedPassword}}"
  }
}

docs {
  Run "Get CSRF token" in the auth folder first.
}

script:post-response {
  bru.setVar("csrfToken", res.body.csrfToken);
}

assert {
  res.status: eq 200
}
