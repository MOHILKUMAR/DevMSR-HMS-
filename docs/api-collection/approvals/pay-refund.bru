meta {
  name: Pay out the approved refund
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/refund-requests/{{refundRequestId}}/pay
  body: json
  auth: none
}

headers {
  X-CSRF-Token: {{csrfToken}}
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {}
}

docs {
  As the cashier, with an open shift, after the MD approved it. Cash needs no details.
}

script:pre-request {
  // A new key each run. Send the request again without this script to see the stored response.
  bru.setVar("idempotencyKey", require("crypto").randomUUID());
}

assert {
  res.status: eq 201
}
