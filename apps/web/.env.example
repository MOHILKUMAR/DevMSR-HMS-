# Copy to apps/web/.env.local for local development.
# Anything starting with NEXT_PUBLIC_ is sent to every browser, so never put a secret there.

# What the browser calls.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# What Server Components call from inside the server. In Docker: http://api:4000/api/v1
API_INTERNAL_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
