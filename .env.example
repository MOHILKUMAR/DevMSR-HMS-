# Copy to .env for local development. Real values are filled in by the developer only.
# Never commit .env, and never put live keys in it outside production.

NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Local PostgreSQL from docker-compose.yml. Development only, bound to 127.0.0.1.
DATABASE_URL=postgresql://hms:hms_local_only@localhost:5432/hms
DIRECT_URL=postgresql://hms:hms_local_only@localhost:5432/hms

# Generate each with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
FIELD_ENCRYPTION_KEY=

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_FILES=hms-files
SENTRY_DSN=

# Mock adapters are the default everywhere except production.
PAYMENTS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
ABDM_MODE=off

MAIL_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=
MAIL_REPLY_TO=
