# Copy to .env for local development. Real values are filled in by the developer only.
# Never commit .env, and never put live keys in it outside production.

NODE_ENV=development
# development, staging or production. Production refuses mock adapters, a missing SENTRY_DSN and demo
# secrets, and requires NODE_ENV=production.
APP_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Local PostgreSQL from docker-compose.yml. Development only, bound to 127.0.0.1.
# DIRECT_URL is the owner of the tables: migrations and pnpm db:api-user use it.
# DATABASE_URL is the API's own login, a member of the restricted hms_api role (no schema changes, no
# changes to audit rows). Create it with pnpm db:api-user after pnpm db:migrate. Its password needs 16
# or more characters.
DATABASE_URL=postgresql://hms_app:hms_app_local_only@localhost:5432/hms
DIRECT_URL=postgresql://hms:hms_local_only@localhost:5432/hms
# API tests wipe and migrate this database as its owner (name must end in _test), then create their
# own restricted API login for it, so this user needs the CREATEROLE right (the Docker user has it).
TEST_DATABASE_URL=postgresql://hms:hms_local_only@localhost:5432/hms_test

# Generate each with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
FIELD_ENCRYPTION_KEY=

# Session cookies are shared by the app. and api. hosts through this parent domain, for example
# .devmsr.in. Leave empty on localhost.
COOKIE_DOMAIN=
# Which proxies may set X-Forwarded-For: loopback, a hop count such as 2 (Cloudflare and Caddy), or true.
TRUST_PROXY=loopback

# Starting values from CLAUDE.md section 9.
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=300
# Password sets and changes per account per hour.
RATE_LIMIT_PASSWORD_PER_HOUR=3

# Password for every demo user that pnpm db:seed creates (usernames are listed in prisma/seed-data.ts).
# Development only.
SEED_USER_PASSWORD=demo-only-Passw0rd
# Base32 two-factor secret for the demo users whose role needs it (superadmin, admin, accounts). Add
# it to an authenticator app by hand, or leave it empty and set two-factor up at first sign-in.
# pnpm test:e2e needs it. Development only.
SEED_TOTP_SECRET=

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_FILES=hms-files
SENTRY_DSN=

# Mock adapters are the default everywhere except production.
PAYMENTS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
ABDM_MODE=off

MAIL_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM=
MAIL_REPLY_TO=
